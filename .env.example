# Ghost Hands — local development
# Copy to .env and adjust as needed.
# Full deploy env reference: docs/deploy-m2.md

# Backend (backend/api)
GH_ENV=local
GH_HOST=0.0.0.0
GH_PORT=8000
GH_PUBLIC_API_URL=http://localhost:8000
GH_POINTER_BASE_URL=http://localhost:5173
GH_JOIN_BASE_URL=http://localhost:5173
GH_SESSION_UNUSED_TTL_S=600
GH_SESSION_MAX_TTL_S=7200
GH_MAX_POINTERS=1
GH_AUTO_ADMIT_DEFAULT=true
GH_STUN_URLS=stun:stun.cloudflare.com:3478
# Comma-separated TURN URLs (UDP + TCP + TLS/443) for prod/staging
# GH_TURN_URLS=turn:turn.example:3478?transport=udp,turn:turn.example:3478?transport=tcp,turns:turn.example:443
# GH_TURN_SECRET=
GH_CORS_ORIGINS=http://localhost:5173,http://localhost:1420,https://ghosthands.fortunealebiosu.dev,https://staging.ghosthands.fortunealebiosu.dev

# Pointer / desktop clients
# Local: leave unset to use same-origin Vite proxy (/api, /ws).
# Staging/prod (Vercel): set absolute API hosts.
# VITE_API_BASE_URL=https://api.ghosthands.fortunealebiosu.dev
# VITE_WS_BASE_URL=wss://api.ghosthands.fortunealebiosu.dev
# VITE_POINTER_BASE_URL=https://ghosthands.fortunealebiosu.dev
