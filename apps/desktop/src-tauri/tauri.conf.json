{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghost Hands",
  "version": "0.1.0",
  "identifier": "dev.fortunealebiosu.ghosthands",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420/index.control.html",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "control",
        "title": "Ghost Hands",
        "width": 420,
        "height": 520,
        "resizable": true,
        "visible": true,
        "decorations": true
      },
      {
        "label": "overlay",
        "title": "Ghost Hands Overlay",
        "url": "index.overlay.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "fullscreen": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.ghosthands.fortunealebiosu.dev wss://api.ghosthands.fortunealebiosu.dev http://localhost:8000 ws://localhost:8000; img-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
