{
  "name": "ghost-hands",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/dev-harness"
  ],

  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "codegen": "bun run --filter @ghost-hands/protocol codegen",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
